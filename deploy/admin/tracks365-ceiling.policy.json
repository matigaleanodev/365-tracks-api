{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/tracks365-api-http:*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:650387442642:table/tracks365-tracks"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/tracks365-api-generate:*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:650387442642:table/tracks365-tracks"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/spotify/client-id",
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/spotify/client-secret",
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/openai/api-key",
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/openai/model",
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/selection/criteria-weights"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/tracks365-api-playlist:*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:650387442642:table/tracks365-tracks"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameters"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/spotify/client-id",
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/spotify/client-secret",
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/spotify/refresh-token"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/spotify/refresh-token"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameterHistory"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/spotify/refresh-token"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameters",
        "ssm:PutParameter"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/spotify/client-id",
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/spotify/client-secret",
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/spotify/refresh-token",
        "arn:aws:ssm:us-east-1:650387442642:parameter/tracks365/spotify/refresh-token-seed-sha256"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:650387442642:function:tracks365-api-generate",
        "arn:aws:lambda:us-east-1:650387442642:function:tracks365-api-playlist"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:DescribeChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:650387442642:stack/tracks365-api/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::tracks365-assets-650387442642-us-east-1/tracks365-api/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::tracks365-assets-650387442642-us-east-1"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:650387442642:stack/tracks365-api/*"
      ],
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::650387442642:role/tracks365-cloudformation"
        },
        "StringLike": {
          "cloudformation:ChangeSetName": "tracks365-api-*"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:DeleteChangeSet"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:650387442642:stack/tracks365-api/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::650387442642:role/tracks365-cloudformation"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:DescribeChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:650387442642:stack/tracks365-api/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudformation:ExecuteChangeSet"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:650387442642:stack/tracks365-api/*"
      ],
      "Condition": {
        "StringLike": {
          "cloudformation:ChangeSetName": [
            "arn:aws:cloudformation:us-east-1:650387442642:changeSet/tracks365-api-*/*",
            "tracks365-api-*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::tracks365-assets-650387442642-us-east-1/tracks365-api/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:ListTagsOfResource"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:650387442642:table/tracks365-tracks"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionRecursionConfig",
        "lambda:GetRuntimeManagementConfig",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:650387442642:function:tracks365-api-http",
        "arn:aws:lambda:us-east-1:650387442642:function:tracks365-api-generate",
        "arn:aws:lambda:us-east-1:650387442642:function:tracks365-api-playlist"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::650387442642:role/tracks365-http",
        "arn:aws:iam::650387442642:role/tracks365-generate",
        "arn:aws:iam::650387442642:role/tracks365-playlist"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::650387442642:role/tracks365-scheduler"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule"
      ],
      "Resource": [
        "arn:aws:scheduler:us-east-1:650387442642:schedule/default/tracks365-daily-track",
        "arn:aws:scheduler:us-east-1:650387442642:schedule/default/tracks365-playlist-sync"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource",
        "logs:GetDataProtectionPolicy"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/tracks365-api-http",
        "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/tracks365-api-http:*",
        "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/tracks365-api-generate",
        "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/tracks365-api-generate:*",
        "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/tracks365-api-playlist",
        "arn:aws:logs:us-east-1:650387442642:log-group:/aws/lambda/tracks365-api-playlist:*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "apigateway:POST"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis"
      ],
      "Condition": {
        "StringEquals": {
          "apigateway:Request/ApiName": "365-tracks-api"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PATCH",
        "apigateway:PUT",
        "apigateway:DELETE",
        "apigateway:TagResource"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis/*"
      ]
    }
  ]
}
