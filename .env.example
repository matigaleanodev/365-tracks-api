# Copiar a .env (ignorado por Git). Sin secretos: las credenciales viven en Parameter Store.
# `npm run synth` carga .env si existe. Las opciones del contexto de CDK (-c clave=valor)
# tienen prioridad sobre estas variables.

# --- Infraestructura (CDK) ---

# Orígenes permitidos por CORS, separados por coma. Vacío = sin cabeceras CORS.
# Se rechaza "*"; https obligatorio salvo localhost. En el despliegue lo define el input
# cors_allowed_origins del workflow. Contexto: corsAllowedOrigins
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Hora UTC (HH:mm) a la que se dispara la generación diaria. Contexto: publishTimeUtc
PUBLISH_TIME_UTC=00:00

# Habilita el schedule de reposición del catálogo. Contexto: scheduleEnabled
SCHEDULE_ENABLED=false

# Hora UTC (HH:mm) de la sincronización de la playlist; no puede ser anterior a 12:00.
# Contexto: playlistSyncTimeUtc
PLAYLIST_SYNC_TIME_UTC=12:30

# Habilita el schedule de la playlist, independiente del anterior. Contexto: playlistScheduleEnabled
PLAYLIST_SCHEDULE_ENABLED=false

# --- Preview de selección con --live (npm run preview:selection; ver TESTING.es.md) ---
# Solo en tu shell y con autorización; no los guardes en archivos versionados.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# CRITERIA_WEIGHTS=

# --- Pruebas de integración (npm run test:integration; ver TESTING.es.md) ---
# DYNAMODB_LOCAL_ENDPOINT=
# DOCKER_BIN=

# --- Runtime local (npm run invoke) ---

# Sirve canciones ficticias de desarrollo en lugar de un repositorio vacío.
USE_DEV_FIXTURES=true
