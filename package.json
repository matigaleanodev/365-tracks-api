{
  "name": "365-tracks-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend serverless de 365 Tracks: una canción distinta por día.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/integration-dynamodb.ts",
    "build": "node scripts/build.mjs",
    "invoke": "node scripts/invoke-local.ts",
    "preview:selection": "node scripts/preview-selection.ts",
    "synth": "npm run build && cdk synth --quiet --no-lookups",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run synth && npm run synth:foundation",
    "synth:foundation": "cdk synth --quiet --no-lookups --app \"node infra/foundation-app.ts\" --output cdk.foundation.out",
    "admin:policies": "node scripts/generate-admin-policies.ts"
  },
  "dependencies": {
    "@middy/core": "7.9.2",
    "@middy/http-router": "7.9.2"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1175.0",
    "@aws-sdk/client-ssm": "3.1175.0",
    "@aws-sdk/lib-dynamodb": "3.1175.0",
    "@eslint/js": "10.0.1",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "aws-cdk": "2.1149.0",
    "aws-cdk-lib": "2.278.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
