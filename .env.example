# Copiar a .env (ignorado por Git). Sin secretos: este proyecto todavía no usa ninguno.
# `npm run synth` carga .env si existe. Las opciones del contexto de CDK (-c clave=valor)
# tienen prioridad sobre estas variables.

# --- Infraestructura (CDK) ---

# Orígenes permitidos por CORS, separados por coma. Vacío = sin cabeceras CORS.
# Usar "*" solo si se quiere abrir la API a cualquier origen. Contexto: corsAllowedOrigins
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Hora UTC (HH:mm) a la que se dispara la generación diaria. Contexto: publishTimeUtc
PUBLISH_TIME_UTC=00:00

# Habilita el schedule de EventBridge. Mantener en false hasta que exista la selección real.
# Contexto: scheduleEnabled
SCHEDULE_ENABLED=false

# --- Runtime local (npm run invoke) ---

# Sirve canciones ficticias de desarrollo en lugar de un repositorio vacío.
USE_DEV_FIXTURES=true
